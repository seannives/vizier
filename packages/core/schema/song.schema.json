{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/seannives/vizier/schema/song.schema.json",
  "title": "vizier song",
  "description": "projects/<id>/song.json: the facts about a song, shared by all its videos.",
  "type": "object",
  "required": ["version", "title", "tracks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "title": { "type": "string", "minLength": 1 },
    "artist": { "type": "string" },
    "release": { "type": "string", "description": "Single, EP or album this song belongs to" },
    "tracks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "file"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Fixed id used in references; never changes" },
          "name": { "type": "string", "minLength": 1, "description": "Display name" },
          "file": { "type": "string", "description": "Audio file, relative to the project folder" },
          "mix": { "type": "boolean", "description": "The track whose audio goes into the video (exactly one)" }
        }
      }
    },
    "grid": { "$ref": "#/definitions/grid" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name"], "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "bar": { "type": "number" }, "t": { "type": "number" } }
      }
    },
    "palette": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
  },
  "definitions": {
    "grid": {
      "type": "object", "required": ["tempo"], "additionalProperties": false,
      "properties": {
        "tempo": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["bar", "bpm"], "additionalProperties": false,
            "properties": {
              "bar": { "type": "number" },
              "bpm": { "type": "number", "exclusiveMinimum": 0 },
              "beatsPerBar": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "downbeat": { "type": "number", "minimum": 0, "description": "Seconds into the audio where bar 1 starts" },
        "barLabelOffset": { "type": "number", "description": "Added to bar numbers for display, e.g. to match Live" }
      }
    }
  }
}
