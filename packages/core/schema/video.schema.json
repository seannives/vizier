{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/seannives/vizier/schema/video.schema.json",
  "title": "vizier video",
  "description": "projects/<id>/videos/<name>.json: one video of a song. With `base`, it builds on another video.",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "name": {
      "type": "string"
    },
    "base": {
      "type": "string",
      "description": "Another video in this project to build on"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Deprecated: use format"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "number"
        },
        "to": {
          "type": "number"
        }
      },
      "description": "Bars; `to` is where the video ends (exclusive)"
    },
    "fade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "out": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        }
      },
      "description": "Audio fades in beats where the range cuts into the song (default: in 0, out 1; a cut is always de-clicked)"
    },
    "cover": {
      "type": "number",
      "minimum": 1,
      "description": "The cover image's moment, a bar position (33.5: half way through bar 33). None: the video's first frame"
    },
    "seed": {
      "type": "integer"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "description": "Five colour slots; `acid` is the older name for `accent`",
      "properties": {
        "bg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "extra1": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "extra2": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "acid": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          },
          "remove": {
            "type": "boolean",
            "description": "Drop this layer inherited from the base"
          },
          "track": {
            "type": "string"
          },
          "generator": {
            "type": "string"
          },
          "z": {
            "type": "number"
          },
          "opacity": {
            "type": "number"
          },
          "blend": {
            "enum": [
              "normal",
              "add",
              "screen",
              "multiply"
            ]
          },
          "resolutionScale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "layout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "landscape": {
                "$ref": "#/definitions/transform"
              },
              "portrait": {
                "$ref": "#/definitions/transform"
              },
              "feed": {
                "$ref": "#/definitions/transform"
              }
            }
          },
          "colors": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^(#[0-9A-Fa-f]{6}|bg|ink|accent|extra1|extra2|acid)$"
            },
            "description": "Generator colour → #rrggbb or a palette slot"
          },
          "spans": {
            "type": "array",
            "description": "When the layer is on, in bars (`to` exclusive; open-ended when missing); fades in beats. No spans: on for the whole song.",
            "items": {
              "type": "object",
              "required": [
                "from"
              ],
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "number"
                },
                "to": {
                  "type": "number"
                },
                "fadeIn": {
                  "type": "number",
                  "minimum": 0,
                  "description": "beats"
                },
                "fadeOut": {
                  "type": "number",
                  "minimum": 0,
                  "description": "beats"
                }
              }
            }
          }
        }
      }
    },
    "automation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "points"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [],
              "additionalProperties": false,
              "properties": {
                "bar": {
                  "type": "number"
                },
                "t": {
                  "type": "number"
                },
                "v": {
                  "type": "number"
                },
                "curve": {
                  "enum": [
                    "linear",
                    "hold",
                    "smooth"
                  ]
                },
                "c": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$",
                  "description": "Colour lanes: a colour instead of v"
                },
                "hue": {
                  "enum": [
                    "long"
                  ],
                  "description": "Colour lanes: the fade after this point goes the long way round the colour wheel"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "v"
                  ]
                },
                {
                  "required": [
                    "c"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "modulations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "curve": {
            "enum": [
              "linear",
              "square",
              "sqrt"
            ]
          },
          "remove": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "not": {
                "required": [
                  "remove"
                ],
                "properties": {
                  "remove": {
                    "const": true
                  }
                }
              }
            },
            "then": {
              "required": [
                "amount"
              ]
            }
          }
        ]
      }
    },
    "format": {
      "type": "string",
      "description": "Output format: youtube, youtube60, youtube4k, shorts, reels, igfeed, draft"
    },
    "post": {
      "type": "object",
      "description": "Film grain and vignette when no lane sets them",
      "properties": {
        "grain": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "vignette": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "transform": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        }
      }
    }
  }
}
