        {
          "bar": 9,
          "v": 0.9,
          "curve": "hold"
        },
        {
          "bar": 25,
          "v": 0.5,
          "curve": "smooth"
        },
        {
          "bar": 29,
          "v": 1.1
        }
      ]
    }
